@model IReadOnlyList<ApiSqlSync.Core.Models.SyncJobSummary>

@{
    ViewData["Title"] = "Senkronizasyon İşleri";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Senkronizasyon İşleri</h1>
        <p class="text-muted mb-0">
            SQL'de saklanan kayıt sayıları ve ilerleme bilgileri.
        </p>
    </div>

    <a asp-controller="SyncJobs"
       asp-action="Index"
       class="btn btn-outline-primary">
        Yenile
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Checkpoint bulunan iş</div>
                <div class="fs-2 fw-semibold">@Model.Count</div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Bu işlerdeki toplam kayıt</div>
                <div class="fs-2 fw-semibold">
                    @Model.Sum(job => job.RecordCount).ToString("N0")
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Henüz checkpoint kaydedilmiş bir iş bulunmuyor.
        İlk aktarım tamamlandığında iş burada görünecek.
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">İş</th>
                        <th scope="col" class="text-end">Kayıt sayısı</th>
                        <th scope="col" class="text-end">Cursor zamanı</th>
                        <th scope="col" class="text-end">Cursor ID</th>
                        <th scope="col">Checkpoint kaydedilme zamanı</th>
                        <th scope="col">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@job.JobId</td>
                            <td class="text-end">
                                @job.RecordCount.ToString("N0")
                            </td>
                            <td class="text-end">
                                @job.Checkpoint.UpdatedAt
                            </td>
                            <td class="text-end">
                                @job.Checkpoint.Id
                            </td>
                            <td>
                                @job.CheckpointSavedAtUtc.ToString(
                                    "yyyy-MM-dd HH:mm:ss 'UTC'")
                            </td>
                            <td>
                                <a asp-controller="SyncRuns"
                                   asp-action="Index"
                                   asp-route-jobId="@job.JobId"
                                   class="btn btn-sm btn-outline-primary">
                                    Geçmiş
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<p class="text-muted small mt-3">
    Cursor zamanı, kaynağın sayısal zaman değeridir.
    Checkpoint kaydedilme zamanı ise ilerlemenin SQL'e yazıldığı UTC zamandır.
    Sayfa yenilendiğinde bilgiler yeniden okunur.
</p>